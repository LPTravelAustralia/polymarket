# Copy to .env and fill in. Never commit .env.

# --- Credentials (only needed for live/paper trading, not for research) ---
# Private key of the EOA that signs orders. For a Polymarket UI account this is
# the key that controls the proxy wallet, not the proxy wallet address itself.
POLYBOT_PRIVATE_KEY=

# Your Polymarket proxy/funder address (0x...). Shown as your wallet on the site.
POLYBOT_FUNDER_ADDRESS=

# Signature type: 0 = EOA, 1 = email/magic proxy, 2 = browser wallet proxy.
POLYBOT_SIGNATURE_TYPE=2

# L2 API credentials. Leave blank to derive them from the private key on startup.
POLYBOT_API_KEY=
POLYBOT_API_SECRET=
POLYBOT_API_PASSPHRASE=

# --- Runtime ---
# dry_run never sends orders. paper simulates fills. live sends real orders.
POLYBOT_MODE=dry_run
POLYBOT_LOG_LEVEL=INFO

# --- Fair value model ---
# the-odds-api.com key, for the sports model (`polybot run --sports`).
# Free tier is ~500 requests/month, so the client caches aggressively.
POLYBOT_ODDS_API_KEY=

# --- Strategy tuning ---
# Minimum net edge per share required to post a quote (probability units).
POLYBOT_MIN_EDGE=0.005

# Estimated adverse selection per maker fill. THIS IS A PLACEHOLDER until you
# measure it: run `polybot record`, then `polybot calibrate --data <session>`,
# and set whatever that reports. Too low and the bot quotes too tight and bleeds.
POLYBOT_ADVERSE_SELECTION=0.004

POLYBOT_HALF_SPREAD=0.010
POLYBOT_ORDER_SIZE=20

# --- Risk limits ---
POLYBOT_MAX_POSITION_USD=250
POLYBOT_MAX_EXPOSURE_USD=2500
POLYBOT_DAILY_LOSS_LIMIT=250
POLYBOT_MAX_OPEN_ORDERS=60
POLYBOT_MAX_ORDERS_PER_MIN=30
POLYBOT_MIN_SECONDS_TO_RESOLUTION=3600
