# Polymarket Configuration
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_SECRET=your_polymarket_secret_here
POLYMARKET_PASSPHRASE=your_polymarket_passphrase_here

# Wallet Configuration
WALLET_PRIVATE_KEY=your_ethereum_private_key_here
WALLET_ADDRESS=your_ethereum_address_here

# AI Configuration (Optional - for AI-powered predictions)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Trading Configuration
DEFAULT_TRADE_SIZE=10
MAX_POSITION_SIZE=1000
RISK_PERCENTAGE=0.02
MIN_LIQUIDITY=1000

# Fee Configuration (for bot usage fees)
FEE_PERCENTAGE=0.01
FEE_WALLET_ADDRESS=your_fee_collection_wallet_address_here

# Network Configuration
POLYGON_RPC_URL=https://polygon-rpc.com
CHAIN_ID=137

# Bot Configuration
BOT_MODE=testnet
LOG_LEVEL=INFO
DRY_RUN=true

# Database (Optional)
DATABASE_URL=sqlite:///polymarket_bot.db

# Advanced Configuration
USE_AI_PREDICTIONS=false
AUTO_TRADE=false
MONITORING_INTERVAL=60
MAX_CONCURRENT_TRADES=5
