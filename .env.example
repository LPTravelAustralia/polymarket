# ============================================================
# POLYMARKET TRADING BOT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to git!
# ============================================================

# ============================================================
# WALLET CONFIGURATION (REQUIRED FOR LIVE TRADING)
# ============================================================
# Your Polygon wallet private key (starts with 0x)
# This is used to sign transactions and derive CLOB API credentials
# Generate: python -c "from eth_account import Account; a = Account.create(); print(a.key.hex())"
POLYGON_WALLET_PRIVATE_KEY=your_polygon_wallet_private_key_here

# Your wallet address (derived from private key, for reference)
WALLET_ADDRESS=your_polygon_wallet_address_here

# ============================================================
# POLYMARKET CLOB API (REQUIRED FOR LIVE TRADING)
# ============================================================
# These are auto-derived from your wallet key using py-clob-client
# Run this to generate:
#   from py_clob_client.client import ClobClient
#   client = ClobClient("https://clob.polymarket.com", key=PRIVATE_KEY, chain_id=137)
#   creds = client.create_or_derive_api_creds()
#   print(creds.api_key, creds.api_secret, creds.api_passphrase)
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_SECRET=your_polymarket_secret_here
POLYMARKET_PASSPHRASE=your_polymarket_passphrase_here

# ============================================================
# AI CONFIGURATION (REQUIRED FOR AI-POWERED PREDICTIONS)
# ============================================================
# OpenAI API key for GPT-4 predictions
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key for Claude predictions (optional, fallback)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# EXTERNAL DATA CONNECTORS (OPTIONAL BUT RECOMMENDED)
# ============================================================
# NewsAPI key for news-driven trading and context in predictions
# Get yours at: https://newsapi.org/register (free tier: 100 requests/day)
# REQUIRED for news monitoring bot
NEWSAPI_KEY=your_newsapi_key_here

# Twitter API Bearer Token for trending validation
# Get yours at: https://developer.twitter.com (free tier: 500k tweets/month)
# OPTIONAL for enhanced news signal validation
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Tavily API key for AI-powered web search
# Get yours at: https://tavily.com (free tier available)
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================================
# NEWS-DRIVEN TRADING CONFIGURATION
# ============================================================
# How often to check for breaking news (seconds)
# Lower = faster reactions, but uses more API calls
# Recommended: 180-600 (3-10 minutes)
NEWS_MONITORING_INTERVAL=300

# Minimum impact score to generate trading signal (0.0-1.0)
# Higher = only trade on high-impact news
# Recommended: 0.6-0.7
NEWS_MIN_IMPACT_SCORE=0.6

# Minimum confidence to execute trade (0.0-1.0)
# Higher = fewer but more confident trades
# Recommended: 0.65-0.75
NEWS_MIN_CONFIDENCE=0.65

# Maximum age of news to consider (hours)
# Only trade on fresh news
# Recommended: 1-3 hours
NEWS_MAX_AGE_HOURS=2

# Enable Twitter trending validation
# Boosts confidence when keywords are trending
# Requires TWITTER_BEARER_TOKEN
NEWS_USE_TWITTER=false

# ============================================================
# TRADING CONFIGURATION
# ============================================================
# Default trade size in USDC
DEFAULT_TRADE_SIZE=10

# Maximum position size per market in USDC
MAX_POSITION_SIZE=1000

# Risk percentage per trade (0.02 = 2%)
RISK_PERCENTAGE=0.02

# Minimum liquidity to consider a market
MIN_LIQUIDITY=1000

# ============================================================
# FEE CONFIGURATION (BOT MONETIZATION)
# ============================================================
# Percentage fee on profitable trades (0.01 = 1%)
FEE_PERCENTAGE=0.01

# Wallet address to collect fees
FEE_WALLET_ADDRESS=your_fee_collection_wallet_address_here

# ============================================================
# NETWORK CONFIGURATION
# ============================================================
# Polygon RPC URL (mainnet)
POLYGON_RPC_URL=https://polygon-rpc.com

# Chain ID (137 = Polygon mainnet, 80002 = Polygon Amoy testnet)
CHAIN_ID=137

# ============================================================
# BOT OPERATION MODE
# ============================================================
# Bot mode: 'mainnet' or 'testnet'
BOT_MODE=mainnet

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# IMPORTANT: Set to true to test without real trades
# Set to false only when ready for live trading!
DRY_RUN=true

# ============================================================
# DATABASE CONFIGURATION (OPTIONAL)
# ============================================================
# Database URL for trade history and positions
# SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite:///polymarket_bot.db

# ============================================================
# ADVANCED CONFIGURATION
# ============================================================
# Enable AI predictions in trading decisions
USE_AI_PREDICTIONS=false

# Enable automatic trade execution (CAREFUL!)
AUTO_TRADE=false

# Market monitoring interval in seconds
MONITORING_INTERVAL=60

# Maximum concurrent open trades
MAX_CONCURRENT_TRADES=5

# ============================================================
# BACKEND CONFIGURATION (FOR DEPLOYMENT)
# ============================================================
# Backend URL for frontend to connect
BACKEND_URL=http://localhost:8000

# CORS origins allowed (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-netlify-app.netlify.app
